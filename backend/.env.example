# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (Atlas or local)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/portfolio?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/portfolio
MONGO_URI=

# Admin Security Key for protected endpoints (e.g. GET /api/contacts)
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Optional Email Configuration (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
